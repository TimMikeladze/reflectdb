{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": ["src", "api", "lib", "schema.ts"]
}
